# Variables de entorno — copiar a .env y completar
PORT=5000
# Usar la URI estandar (mongodb://) con hosts explicitos para evitar problemas
# de resolucion DNS SRV en entornos locales. Obtenerla en Atlas:
# Cluster -> Connect -> Connect your application -> Standard connection string
MONGO_URI=mongodb://<USER>:<PASSWORD>@devoscar-shard-00-00.h7chs.mongodb.net:27017,devoscar-shard-00-01.h7chs.mongodb.net:27017,devoscar-shard-00-02.h7chs.mongodb.net:27017/<bd>?ssl=true&replicaSet=atlas-nqgzg1-shard-0&authSource=admin
JWT_SECRET=cambia-este-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=7d
NODE_ENV=development

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CORS (origen del frontend)
FRONTEND_ORIGIN=http://localhost:5173
